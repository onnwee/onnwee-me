---
/* Pixel icons on a 12×12 grid, drawn here so they match the rest of the page. `#` is a filled pixel. */
import type { LinkIcon } from '../site';

interface Props { name: LinkIcon }
const { name } = Astro.props;

const ICONS: Record<LinkIcon, string[]> = {
  code: [
    '............', '............', '.......#....', '...#...#.#..', '..#...#...#.', '.#....#....#',
    '.#...#.....#', '..#..#....#.', '...#.#...#..', '....#.......', '............', '............',
  ],
  mail: [
    '............', '............', '############', '##........##', '#.#......#.#', '#..#....#..#',
    '#...#..#...#', '#....##....#', '#..........#', '############', '............', '............',
  ],
  feed: [
    '............', '.######.....', '.......##...', '.........#..', '.####.....#.', '.....##...#.',
    '.......#...#', '........#..#', '.##.....#..#', '.##.....#..#', '............', '............',
  ],
  chat: [
    '............', '.##########.', '#..........#', '#..........#', '#.##.##.##.#', '#.##.##.##.#',
    '#..........#', '#..........#', '.###..#####.', '...#.#......', '...##.......', '............',
  ],
  /* an arrow leaving a box: opens the running thing */
  open: [
    '............', '.....#######', '.........###', '........#.##', '.#####.#..##', '.#....#....#',
    '.#...#.....#', '.#.........#', '.#.........#', '.#.........#', '.###########', '............',
  ],
  video: [
    '............', '############', '#..........#', '#...#......#', '#...###....#', '#...#####..#',
    '#...###....#', '#...#......#', '#..........#', '############', '....####....', '............',
  ],
};
const pixels = ICONS[name].flatMap((row, y) => [...row].flatMap((ch, x) => (ch === '#' ? [{ x, y }] : [])));
---
<svg viewBox="0 0 12 12" width="24" height="24" shape-rendering="crispEdges" fill="currentColor" aria-hidden="true">
  {pixels.map(({ x, y }) => <rect x={x} y={y} width="1" height="1" />)}
</svg>
