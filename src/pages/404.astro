---
import Base from '../layouts/Base.astro';
import Window from '../components/Window.astro';
---
<Base title="No signal · onnwee" description="This channel is off the air." intro={false} scene="nosignal">
  <section class="nosignal" data-spot="signal" data-ch="00" data-name="no signal" aria-labelledby="ns-h">
    <Window title="404" slotClass="ns-card" status={['channel not found', 'CH 00']}>
      <h1 id="ns-h" class="ns-title">Nothing on this channel.</h1>
      <p>The page you asked for isn't here. It may have moved, or it never existed.</p>
      <div class="buttons"><a class="btn default" href="/">Back to CH 01</a></div>
    </Window>
  </section>
</Base>
